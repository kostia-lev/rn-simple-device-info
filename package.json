{
  "name": "rn-simple-device-info",
  "version": "0.1.0",
  "description": "A small React Native Turbo Module for reading the app name, version, and build number on Android and iOS.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "rn-simple-device-info-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "!ios/build",
    "!android/build",
    "!**/__tests__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli android/build generated ios/build lib",
    "codegen": "node node_modules/@react-native/codegen/lib/cli/combine/combine-js-to-schema-cli.js --platform android generated/schema.json src && node node_modules/react-native/scripts/generate-specs-cli.js -p android -s generated/schema.json -o generated/android -n RNSimpleDeviceInfoSpec -j com.rnsimpledeviceinfo -t modules && node node_modules/react-native/scripts/generate-specs-cli.js -p ios -s generated/schema.json -o generated/ios -n RNSimpleDeviceInfoSpec -t modules",
    "precodegen": "node -e \"require('fs').mkdirSync('generated', { recursive: true })\"",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "react-native-turbo-module",
    "device-info",
    "app-version",
    "build-number",
    "android",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konstantinvakhrushev/rn-simple-device-info.git"
  },
  "author": "Konstantin Vakhrushev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/konstantinvakhrushev/rn-simple-device-info/issues"
  },
  "homepage": "https://github.com/konstantinvakhrushev/rn-simple-device-info#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "react": "19.2.3",
    "react-native": "0.84.0",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.84.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNSimpleDeviceInfoSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnsimpledeviceinfo"
    },
    "ios": {
      "modulesProvider": {
        "NativeSimpleDeviceInfo": "RNSimpleDeviceInfo"
      }
    }
  }
}
